# =========================================================================
# KPIso — Root GitIgnore
# =========================================================================

# ─── SYSTEM FILES ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── IDEs & EDITORS ──────────────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.classpath
.project
.factorypath
*.sublime-project
*.sublime-workspace

# ─── ENVIRONMENT VARIABLES ────────────────────────────────────────────────
# Solo ignoramos archivos de variables de entorno locales, pero mantenemos .env en el control de versiones como plantilla de desarrollo.
# Si prefieres ignorar el .env por completo, descomenta la siguiente línea:
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ─── BACKEND (Java / Maven) ──────────────────────────────────────────────
KPIso-backend/target/
KPIso-backend/out/
KPIso-backend/.mvn/wrapper/maven-wrapper.jar
KPIso-backend/mvnw.cmd
KPIso-backend/mvnw
*.jar
*.war
*.ear
*.class
.mvn/

# ─── FRONTEND (Node / React / Vite) ──────────────────────────────────────
KPIso-frontend/node_modules/
KPIso-frontend/dist/
KPIso-frontend/dist-ssr/
KPIso-frontend/coverage/
KPIso-frontend/.svelte-kit/
KPIso-frontend/.next/
KPIso-frontend/.nuxt/
KPIso-frontend/.output/
KPIso-frontend/build/
.npm
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── DOCKER & VOLUMES ────────────────────────────────────────────────────
# Si los volúmenes o bases de datos locales se guardan en el workspace
pgdata/
postgres-data/

# ─── SCRAPER ─────────────────────────────────────────────────────────────
kpiso-scraper/__pycache__/
